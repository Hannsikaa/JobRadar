# Copy to `.env.local` and fill in real values. `.env*` is gitignored.
#
#   cp .env.example .env.local
#
# Every variable below is optional for local development. Job Radar starts and
# runs with none of them set: the health endpoint reports the missing pieces as
# "skipped" instead of failing.

# --- MongoDB -------------------------------------------------------------
# Server-side only. Never prefix this with NEXT_PUBLIC_.
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://USER:PASSWORD@cluster.mongodb.net
MONGODB_URI=
MONGODB_DB_NAME=job_radar
MONGODB_MAX_POOL_SIZE=10

# --- SerpApi -------------------------------------------------------------
# Server-side only. Job Radar uses SerpApi as the single job-discovery source.
# Create a key at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
SERPAPI_BASE_URL=https://serpapi.com

# --- Official-careers discovery (optional) -------------------------------
# A bounded enrichment stage: after the normal scan, up to this many distinct
# employer+role+location listings get one extra web lookup each, to find the
# employer's own job page or an employer-specific ATS posting. Verified
# destinations are cached so repeat scans do not pay again.
#
# Each uncached target is ONE additional SerpApi request per scan. Set to 0 to
# disable the stage entirely (the pipeline then runs exactly as before).
OFFICIAL_DISCOVERY_MAX_TARGETS=3
OFFICIAL_DISCOVERY_CONCURRENCY=2
OFFICIAL_DISCOVERY_CACHE_TTL_DAYS=7
OFFICIAL_DISCOVERY_NEGATIVE_TTL_HOURS=24

# --- Employer-board discovery (optional) ---------------------------------
# Reads an employer's own job board directly through its public, documented ATS
# JSON API (Greenhouse, Lever, Ashby). A board is only queried when a listing the
# provider already returned carries that employer's verified board link, and only
# postings matching one of your target roles are kept. No key required.
#
# This finds jobs a search never surfaced. Each queried board is one HTTP request
# to the ATS. Set DIRECT_SOURCE_MAX_TARGETS=0 to disable the stage entirely.
DIRECT_SOURCE_MAX_TARGETS=5
DIRECT_SOURCE_CONCURRENCY=3
DIRECT_SOURCE_MAX_POSTINGS_PER_BOARD=25
DIRECT_SOURCE_MAX_TOTAL_POSTINGS=60

# --- Client-visible ------------------------------------------------------
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time.
NEXT_PUBLIC_APP_NAME=Job Radar